projection;
strict ( 2 );

define behavior for zvai_c_travel_m //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _Booking { create; }
}

define behavior for zvai_c_booking_m //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _BookingSuppl { create; }
}

define behavior for zvai_c_booking_suppl_m //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}