managed implementation in class zbp_vai_i_travel_m unique;
strict ( 2 );

define behavior for zvai_i_travel_m //alias <alias_name>
persistent table zvai_travel_m
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) TravelId;
  association _Booking { create; }
}

define behavior for zvai_i_booking_m //alias <alias_name>
